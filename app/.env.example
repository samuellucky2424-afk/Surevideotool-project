# ─────────────────────────────────────────────
# Supabase — public values (safe to share)
# ─────────────────────────────────────────────
VITE_SUPABASE_URL=https://iwausfzgitoehqecrvxc.supabase.co
# Anon/public key — designed for client-side use, protected by Row-Level Security
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─────────────────────────────────────────────
# Supabase — server-side only
# ─────────────────────────────────────────────
SUPABASE_URL=https://iwausfzgitoehqecrvxc.supabase.co
# SERVICE KEY — full database access. NEVER expose to the frontend.
# Set this in Vercel dashboard → Settings → Environment Variables
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ─────────────────────────────────────────────
# API
# ─────────────────────────────────────────────
VITE_API_URL=/api

# ─────────────────────────────────────────────
# Paystack - SECRET, server-side only. Never use a VITE_ prefix.
# Set in Vercel Settings > Environment Variables, then redeploy.
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_paystack_secret_key
# Webhook: https://surevideotool-project.vercel.app/api/paystack-webhook
# No public key is needed: the server initializes checkout and returns an access code.

# Morphly — SECRET, server only; never ship in the desktop installer
# Set this in Vercel dashboard → Settings → Environment Variables
# ─────────────────────────────────────────────
MORPHLY_API_KEY=your_morphly_api_key_here
APP_ORIGIN=http://127.0.0.1:5173
DESKTOP_APP_ORIGIN=http://127.0.0.1:47831

